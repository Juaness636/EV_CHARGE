# Backend - Variables de entorno
# Copiar este archivo a .env y llenar con tus valores reales

# OpenChargeMap API
OCM_API_KEY=TU_CLAVE_DE_OPENCHARGEMAP

# Base de datos PostgreSQL
DB_HOST=TU_HOST_DE_BASE_DE_DATOS
DB_PORT=TU_PUERTO_DE_BASE_DE_DATOS
DB_NAME=TU_NOMBRE_DE_BASE_DE_DATOS
DB_USER=TU_USUARIO_DE_BASE_DE_DATOS
DB_PASSWORD=TU_CONTRASENA_DE_BASE_DE_DATOS

# JWT
# Mínimo 32 caracteres aleatorios: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TU_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ALGORITHM=TU_ALGORITMO_JWT
ACCESS_TOKEN_EXPIRE_MINUTES=TU_DURACION_DEL_TOKEN

# Frontend y CORS
CORS_ORIGINS=TU_ORIGEN_FRONTEND_1,TU_ORIGEN_FRONTEND_2
VITE_API_URL=TU_URL_DEL_BACKEND

# Correo SMTP (Gmail requiere una contraseña de aplicación)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=TU_CORREO_GMAIL
SENDER_PASSWORD=TU_CONTRASENA_DE_APLICACION
# Nombre visible del remitente y dirección de respuesta (opcional)
SENDER_NAME=EV Charge
REPLY_TO_EMAIL=

# Asistente de IA (opcional; si se deja vacío usa el respaldo local)
OPENAI_API_KEY=TU_CLAVE_PRIVADA_DE_OPENAI
OPENAI_MODEL=TU_MODELO_DE_IA
OPENAI_API_URL=TU_ENDPOINT_DEL_PROVEEDOR_DE_IA
AI_TIMEOUT_SECONDS=TU_TIEMPO_MAXIMO_DE_RESPUESTA
AI_RATE_LIMIT_PER_MINUTE=TU_LIMITE_DE_SOLICITUDES
# Tope total de consultas por minuto entre todos los usuarios (protege el costo de la IA)
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=120
