# Backend - Variables de entorno
# Copiar este archivo a .env y llenar con tus valores reales

# OpenChargeMap API
OCM_API_KEY=tu_ocm_api_key_aqui

# Waze API (OpenWebNinja)
# Obtener en: https://rapidapi.com/openwebninja-openwebninja-default/api/waze-live-data
WAZE_API_KEY=tu_waze_api_key_aqui

# Base de datos (si aplica)
DATABASE_URL=sqlite:///./test.db

# JWT
SECRET_KEY=tu_secret_key_super_seguro_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
