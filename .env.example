# Backend - Variables de entorno
# Copiar este archivo a .env y llenar con tus valores reales

# OpenChargeMap API
OCM_API_KEY=tu_ocm_api_key_aqui

# Correo para recuperación de contraseña
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=tu_correo@gmail.com
SENDER_PASSWORD=tu_contraseña_de_aplicacion

# Base de datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ev_charge_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura

# JWT
SECRET_KEY=tu_secret_key_super_seguro_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend y CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_URL=http://127.0.0.1:8000
